<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep dark premium obsidian background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E60D0F16" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Multi-layered glowing soft lighting -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#203E2F4C"
                android:centerColor="#00000000"
                android:endColor="#1C1B2B3E"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Beautiful translucent glass overlay edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>

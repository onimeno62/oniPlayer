<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_standard"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Premium Framed Album Art Cover -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_art_frame"
        android:padding="2dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_standard_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_play_arrow"
            android:scaleType="centerCrop"
            android:contentDescription="Album Art"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Track Metadata Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/widget_standard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OniPlayer"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_standard_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Audio Engine"
            android:textColor="#82828F"
            android:textSize="11sp"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Minimalist Controls Deck -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Previous Button -->
        <ImageView
            android:id="@+id/widget_standard_btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_skip_previous"
            android:contentDescription="Previous"
            android:tint="#FFFFFF" />

        <!-- Floating Glass Circle for Play/Pause -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_btn_circle"
            android:padding="11dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_standard_btn_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Play/Pause"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Next Button -->
        <ImageView
            android:id="@+id/widget_standard_btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="Next"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>

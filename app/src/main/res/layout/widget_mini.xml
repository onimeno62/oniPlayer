<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mini"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Mini Disc Icon (Sleek minimalist indicator) -->
    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_btn_circle"
        android:padding="8dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_mini_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="OniPlayer"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Metadata Section (Left aligned, roomy spacing) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">

        <TextView
            android:id="@+id/widget_mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OniPlayer"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_mini_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Audio"
            android:textColor="#82828F"
            android:textSize="10.5sp"
            android:layout_marginTop="1.5dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Sleek Circle Play/Pause Button -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn_circle"
        android:padding="9dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_mini_btn_play_pause"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="Play/Pause"
            android:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
